# Generated / collected output
data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local secrets and sessions (never commit)
.env
*.session
.env.local
secrets/
credentials/

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Stray Pi diagnostic tooling, not part of the newsletter project
tools/_diag/

# Shadow-mode A/B artifacts: regenerated by tools/run_ab.py on every run
site/digest-legacy.html
site/digest-modern.html
reports/

# Local archive of daily snapshots. Kept on disk for reference, not in version
# control: it is large, changes every run, and is reproducible from the sources.
archive/

# Downloaded Telegram images are derived data: the renderer inlines them into
# site/digest.html as base64, so the shipped artifact is self-contained and the
# originals do not need version control. They also change on every run, which
# would add binary churn for no benefit.
data/telegram/media/
