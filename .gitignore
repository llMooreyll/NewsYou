# Generated / collected output. Includes data/telegram/media/: those images are
# derived data, because the renderer inlines them into site/digest.html as
# base64, so the shipped digest is self-contained and the originals would only
# add binary churn.
data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local secrets and sessions (never commit)
.env
*.session
.env.local
secrets/
credentials/

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Shadow-mode A/B artifacts: regenerated by tools/run_ab.py on every run
site/digest-legacy.html
site/digest-modern.html
reports/

# Local archive of daily snapshots. Kept on disk for reference, not in version
# control: it is large, changes every run, and is reproducible from the sources.
archive/
